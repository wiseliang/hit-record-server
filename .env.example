PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=hit_record

ENCRYPTION_KEY=change-this-to-a-32-character-key!

WX_APPID=your_wechat_appid
WX_APPSECRET=your_wechat_appsecret

# CDP 模式：连到外部 Chrome，避免自动化检测触发验证码
# USE_CDP=true
# CDP_URL=http://127.0.0.1:9222

# Generate with: openssl rand -hex 32
AUTH_SECRET=
# Reserved administrator identities (calendar is school-controlled and read-only)
ADMIN_OPENIDS=

# Private directory, outside the Git checkout, for scheduled logical backups
BACKUP_DIR=

# Optional Staff Finder integration; secret must match the Staff Finder backend.
STAFF_FINDER_URL=http://127.0.0.1:3086/
SCHOOL_BRIDGE_ISSUER=student-recorder
SCHOOL_BRIDGE_SECRET=

# Encrypted teaching-session snapshot retention, 1..168 hours; school expiry is still enforced.
ACADEMIC_SESSION_RETENTION_HOURS=24
# Prefer the official post-verification trust/remember-device button when offered.
SCHOOL_PREFER_TRUSTED_DEVICE=true
